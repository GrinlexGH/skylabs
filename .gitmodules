[submodule "libs/src/SDL"]
	path = libs/src/SDL
	url = https://github.com/libsdl-org/SDL.git
[submodule "libs/src/Boost.Nowide"]
	path = libs/src/Boost.Nowide
	url = https://github.com/boostorg/nowide.git
[submodule "libs/src/SDL_Image"]
	path = libs/src/SDL_image
	url = https://github.com/libsdl-org/SDL_image.git
[submodule "libs/src/glm"]
	path = libs/src/glm
	url = https://github.com/g-truc/glm.git
[submodule "libs/src/VulkanMemoryAllocator-Hpp"]
	path = libs/src/VulkanMemoryAllocator-Hpp
	url = https://github.com/YaaZ/VulkanMemoryAllocator-Hpp.git
[submodule "libs/src/tinyobjloader"]
	path = libs/src/tinyobjloader
	url = https://github.com/tinyobjloader/tinyobjloader.git
[submodule "libs/src/simple_term_colors"]
	path = libs/src/simple_term_colors
	url = https://github.com/illyigan/simple_term_colors.git
[submodule "libs/src/SteamworksSDK"]
	path = libs/src/SteamworksSDK
	url = https://github.com/rlabrecque/SteamworksSDK.git
